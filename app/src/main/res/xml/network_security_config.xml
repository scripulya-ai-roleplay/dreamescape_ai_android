<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        The backend API is a self-hosted HTTP server (plain HTTP, never TLS),
        and its address is user-configurable at runtime from Advanced settings
        (e.g. the emulator alias 10.0.2.2, or a VPN address like 10.66.66.2).
        Because the host can be anything, cleartext traffic is permitted
        globally instead of being whitelisted per host.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
