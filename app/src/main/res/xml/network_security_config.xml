<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        The backend API is served over plain HTTP on the host machine
        (0.0.0.0:8000). Cleartext traffic is blocked by default on modern
        Android, so it is explicitly allowed only for the local development
        hosts reachable from the emulator.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
