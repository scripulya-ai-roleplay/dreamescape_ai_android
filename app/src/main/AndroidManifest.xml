<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
            android:name=".DreamescapeApplication"
            android:allowBackup="true"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:fullBackupContent="@xml/backup_rules"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:networkSecurityConfig="@xml/network_security_config"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.Dreamescape_ai">
        <activity
                android:name=".ChatActivity"
                android:exported="false"
                android:label="Chat"
                android:theme="@style/Theme.Dreamescape_ai"/>
        <activity
                android:name=".CreateChatActivity"
                android:exported="false"
                android:label="New Chat"
                android:theme="@style/Theme.Dreamescape_ai"/>
        <activity
                android:name=".ChatListActivity"
                android:exported="false"
                android:label="Chats"
                android:theme="@style/Theme.Dreamescape_ai"/>
        <activity
                android:name=".SceneListActivity"
                android:exported="false"
                android:label="Scenes"
                android:theme="@style/Theme.Dreamescape_ai"/>
        <activity
                android:name=".CreateSceneActivity"
                android:exported="false"
                android:label="Create Scene"
                android:theme="@style/Theme.Dreamescape_ai"/>
        <activity
                android:name=".CreateCharacterActivity"
                android:exported="false"
                android:label="Create Character"
                android:theme="@style/Theme.Dreamescape_ai"/>
        <activity
                android:name=".StoryGalleryActivity"
                android:exported="false"
                android:label="Stories"
                android:theme="@style/Theme.Dreamescape_ai"/>
        <activity
                android:name=".ChatSettingsActivity"
                android:exported="false"
                android:label="Chat Settings"
                android:theme="@style/Theme.Dreamescape_ai"/>
        <activity
                android:name=".MediaGalleryActivity"
                android:exported="false"
                android:label="Media"
                android:theme="@style/Theme.Dreamescape_ai"/>
        <activity
                android:name=".MainActivity"
                android:exported="true"
                android:label="@string/app_name"
                android:theme="@style/Theme.Dreamescape_ai">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>

</manifest>